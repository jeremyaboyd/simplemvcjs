# Server
HOST=localhost
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string

# Database (required when using App.initDbConnection)
MONGO_SCHEME=mongodb
MONGO_USER=
MONGO_PASSWORD=
MONGO_SERVER=localhost:27017
MONGO_DB=simplemvc

# SMTP (required when using SimpleMVC.SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Simple Blog example admin login (bcrypt hash of your password)
ADMIN_PASSWORD=
