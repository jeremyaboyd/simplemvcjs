# Server
HOST=localhost
PORT=8080
SESSION_SECRET=change-me-to-a-long-random-string

# Database (required when using App.initDatabase)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=simplemvc
DB_USER=
DB_PASSWORD=
DB_STORAGE=./data/simplemvc.sqlite

# SMTP (required when using SimpleMVC.SMTP)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Simple Blog example admin login (bcrypt hash of your password)
ADMIN_PASSWORD=
